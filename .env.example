# AethonX Configuration File Example
# Copy this file to .env and fill in your values

# ==============================================================================
# SHODAN CONFIGURATION
# ==============================================================================
# Get free API key: https://account.shodan.io/register
#
# Shodan has 3 tiers of endpoints:
# 1. InternetDB (no API key, completely free)
# 2. Free API endpoints (requires free API key, no credits consumed)
# 3. Paid API endpoints (requires paid plan or query credits)
#
# AethonX attempts ALL available endpoints and gracefully degrades on failures.

# API Key (optional - enables API endpoints)
# AETHONX_SOURCES_SHODAN_API_KEY=your_shodan_api_key_here

# Enable Shodan source (default: false)
# AETHONX_SOURCES_SHODAN_ENABLED=true

# Use InternetDB for free IP enrichment - no API key required (default: true)
# AETHONX_SOURCES_SHODAN_USE_INTERNETDB=true

# Use CLI tool instead of API (requires `shodan` binary in PATH)
# AETHONX_SOURCES_SHODAN_USE_CLI=false

# API rate limit in requests per second (default: 1.0 for free tier)
# AETHONX_SOURCES_SHODAN_RATE_LIMIT=1.0

# ==============================================================================
# CORE CONFIGURATION
# ==============================================================================
# AETHONX_TARGET=example.com
# AETHONX_ACTIVE=false
# AETHONX_WORKERS=16
# AETHONX_TIMEOUT=30

# ==============================================================================
# OUTPUT CONFIGURATION
# ==============================================================================
# AETHONX_OUTPUT_DIR=aethonx_out
# AETHONX_UI_MODE=pretty
# AETHONX_LOG_FORMAT=text

# ==============================================================================
# SOURCE CONFIGURATION
# ==============================================================================
# Enable/disable specific sources
# AETHONX_SOURCES_CRTSH_ENABLED=true
# AETHONX_SOURCES_RDAP_ENABLED=true
# AETHONX_SOURCES_SUBFINDER_ENABLED=true
# AETHONX_SOURCES_HTTPX_ENABLED=true
# AETHONX_SOURCES_WAYBACKURLS_ENABLED=true
# AETHONX_SOURCES_GOLINKFINDEREVO_ENABLED=true

# ==============================================================================
# GOLINKFINDEREVO CONFIGURATION
# ==============================================================================
# GoLinkfinderEVO discovers endpoints, API routes, and secrets in JavaScript/HTML.
# Runs in Stage 3 (Crawl), consuming alive HTTP URLs from httpx.
# Requires `golinkfinder` binary in PATH: https://github.com/lcalzada-xor/GoLinkfinderEVO

# Enable golinkfinderevo source (default: true in active mode)
# AETHONX_SOURCES_GOLINKFINDEREVO_ENABLED=true

# Scan profile: quick, standard, deep (default: standard)
# - quick: 10 workers, 30s timeout, no recursion, 25 files each
# - standard: 20 workers, 60s timeout, 1 level recursion, 50 files each
# - deep: 30 workers, 120s timeout, 2 levels recursion, 100 files each
# AETHONX_SOURCES_GOLINKFINDEREVO_PROFILE=standard

# Number of concurrent workers (overrides profile default)
# AETHONX_SOURCES_GOLINKFINDEREVO_WORKERS=20

# Maximum JavaScript files to analyze (default: 50)
# AETHONX_SOURCES_GOLINKFINDEREVO_MAX_SCRIPT_FILES=50

# Maximum HTML files to analyze (default: 50)
# AETHONX_SOURCES_GOLINKFINDEREVO_MAX_HTML_FILES=50

# Path to golinkfinder binary (default: golinkfinder)
# AETHONX_SOURCES_GOLINKFINDEREVO_EXEC_PATH=golinkfinder

# Path to gf templates directory (default: ./internal/platform/gf_templates)
# AETHONX_SOURCES_GOLINKFINDEREVO_GF_TEMPLATES_PATH=./internal/platform/gf_templates

# GF patterns to apply (comma-separated, default: all)
# Available: api-keys, jwt, credentials, sqli, xss, sensitive-files,
#            endpoints, cloud-resources, crypto, custom-params
# Use "all" to apply all patterns
# AETHONX_SOURCES_GOLINKFINDEREVO_GF_PATTERNS=all

# Custom flags to pass to golinkfinder (advanced)
# AETHONX_SOURCES_GOLINKFINDEREVO_CUSTOM_FLAGS=

# ==============================================================================
# STREAMING CONFIGURATION
# ==============================================================================
# AETHONX_STREAMING_THRESHOLD=1000

# ==============================================================================
# NETWORK CONFIGURATION
# ==============================================================================
# AETHONX_PROXY_URL=http://proxy.example.com:8080

# ==============================================================================
# CVE ENRICHMENT CONFIGURATION
# ==============================================================================
# Automatically enrich vulnerability artifacts with comprehensive CVE data from
# external sources (NVD, CVE.circl.lu). Adds CVSS scores, severity ratings,
# CWE classifications, CPE data, and exploit references.

# Enable CVE enrichment (default: true)
# AETHONX_ENRICHMENT_ENABLED=true

# Primary provider: nvd or circl (default: nvd)
# AETHONX_ENRICHMENT_PROVIDER=nvd

# NVD API Key (optional, but recommended for production)
# Get free key: https://nvd.nist.gov/developers/request-an-api-key
# Without key: 0.6 requests/second rate limit
# With key: 50 requests/second rate limit
# AETHONX_ENRICHMENT_NVD_API_KEY=

# Cache TTL for enriched CVEs (default: 168h = 7 days)
# AETHONX_ENRICHMENT_CACHE_TTL=168h

# Timeout per CVE enrichment request (default: 10s)
# AETHONX_ENRICHMENT_TIMEOUT=10s

# Max concurrent enrichment requests (default: 5)
# AETHONX_ENRICHMENT_MAX_CONCURRENT=5
