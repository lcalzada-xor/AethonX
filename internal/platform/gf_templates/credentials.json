{
  "flags": "-HnriE",
  "patterns": [
    "(password|passwd|pwd|pass)[\"']?\\s*[:=]\\s*[\"'][^\"']{4,}[\"']",
    "(secret|secret_key|secretkey)[\"']?\\s*[:=]\\s*[\"'][^\"']{8,}[\"']",
    "(token|auth_token|authtoken|access_token|accesstoken)[\"']?\\s*[:=]\\s*[\"'][^\"']{8,}[\"']",
    "(api_key|apikey|api-key)[\"']?\\s*[:=]\\s*[\"'][^\"']{8,}[\"']",
    "(private_key|privatekey|priv_key)[\"']?\\s*[:=]\\s*[\"'][^\"']{20,}[\"']",
    "Basic\\s+[A-Za-z0-9+/=]{20,}",
    "Bearer\\s+[a-zA-Z0-9\\-._~+/]+=*",
    "(client_secret|clientsecret)[\"']?\\s*[:=]\\s*[\"'][^\"']{16,}[\"']",
    "(encryption_key|encryptionkey)[\"']?\\s*[:=]\\s*[\"'][^\"']{16,}[\"']",
    "(master_key|masterkey)[\"']?\\s*[:=]\\s*[\"'][^\"']{16,}[\"']",
    "conn_str[\"']?\\s*[:=]\\s*[\"']?(mongodb|mysql|postgres|redis)://[^\"']+",
    "CONNECTION_STRING[\"']?\\s*[:=]\\s*[\"'][^\"']{20,}[\"']",
    "Database[\"']?\\s*[:=]\\s*[\"']?(Server|Host)=[^;\"']+",
    "-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----",
    "PRIVATE KEY[\\s\\S]{20,}END PRIVATE KEY"
  ]
}
