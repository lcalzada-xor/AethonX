// Run executes the source against the target.
func (s *{{.StructName}}) Run(ctx context.Context, target domain.Target) (*domain.ScanResult, error) {
	s.GetLogger().Debug("starting {{.Name}} scan", "target", target.Root)

	result := domain.NewScanResult(target)
	result.Metadata.SourcesUsed = []string{s.Name()}

	// Build API URL
	url := s.buildAPIURL(target)

	// Fetch data from API
	body, err := s.client.FetchJSON(ctx, url)
	if err != nil {
		errMsg := fmt.Sprintf("HTTP request failed: %v", err)
		result.AddError(s.Name(), errMsg, false) // Non-fatal - scan can continue
		s.GetLogger().Warn("{{.Name}} request failed", "target", target.Root, "error", err.Error())
		return result, err
	}

	// Parse API response
	var records []{{.ResponseType}}
	if err := json.Unmarshal(body, &records); err != nil {
		// If parsing fails, the API might have returned HTML/error
		result.AddWarning(s.Name(), fmt.Sprintf("failed to parse JSON: %v", err))
		return result, nil
	}

	s.GetLogger().Debug("parsed {{.Name}} records", "count", len(records))

	// Process records and extract artifacts with progress tracking
	artifacts := s.processRecordsWithProgress(ctx, records, target)

	// Add artifacts to result
	for _, a := range artifacts {
		result.AddArtifact(a)
	}

	s.GetLogger().Info("{{.Name}} scan completed",
		"target", target.Root,
		"artifacts", len(artifacts),
	)

	return result, nil
}

