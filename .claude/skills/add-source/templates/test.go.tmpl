	// Clean registry before tests
	registry.Global().Clear()
	m.Run()
}

// TestRegistry_{{.StructName}} validates that {{.Name}} registers correctly.
func TestRegistry_{{.StructName}}(t *testing.T) {
	registry.Global().Clear()

	// Trigger init() by importing the package
	// The init() function should have already run

	// Verify registration
	if !registry.Global().IsRegistered("{{.Name}}") {
		t.Fatal("{{.Name}} source not registered")
	}

	// Verify metadata
	meta, ok := registry.Global().GetMetadata("{{.Name}}")
	if !ok {
		t.Fatal("{{.Name}} metadata not found")
	}

	// Validate metadata fields
	if meta.Name != "{{.Name}}" {
		t.Errorf("expected name '{{.Name}}', got '%s'", meta.Name)
	}

	if meta.Mode != domain.SourceMode{{.Mode}} {
		t.Errorf("expected mode '{{.Mode}}', got '%s'", meta.Mode)
	}

	if meta.Type != domain.SourceType{{.Type}} {
		t.Errorf("expected type '{{.Type}}', got '%s'", meta.Type)
	}

	if meta.Priority != {{.Priority}} {
		t.Errorf("expected priority {{.Priority}}, got %d", meta.Priority)
	}

	if meta.StageHint != {{.StageHint}} {
		t.Errorf("expected stage hint {{.StageHint}}, got %d", meta.StageHint)
	}

	// Validate input/output artifacts
	expectedInputs := []domain.ArtifactType{
{{- range .InputArtifacts}}
		domain.ArtifactType{{.}},
{{- end}}
	}

	if len(meta.InputArtifacts) != len(expectedInputs) {
		t.Errorf("expected %d input artifacts, got %d", len(expectedInputs), len(meta.InputArtifacts))
	}

	expectedOutputs := []domain.ArtifactType{
{{- range .OutputArtifacts}}
		domain.ArtifactType{{.}},
{{- end}}
	}

	if len(meta.OutputArtifacts) != len(expectedOutputs) {
		t.Errorf("expected %d output artifacts, got %d", len(expectedOutputs), len(meta.OutputArtifacts))
	}
}

// TestFactory_{{.StructName}} validates that the factory creates a valid source.
func TestFactory_{{.StructName}}(t *testing.T) {
	logger := logx.New()
	cfg := getTestConfig()

	source, err := factory(cfg, logger)
	if err != nil {
		t.Fatalf("factory failed: %v", err)
	}

	if source == nil {
		t.Fatal("factory returned nil source")
	}

	// Verify interface implementation
	if source.Name() != "{{.Name}}" {
		t.Errorf("expected name '{{.Name}}', got '%s'", source.Name())
	}

	if source.Mode() != domain.SourceMode{{.Mode}} {
		t.Errorf("expected mode '{{.Mode}}', got '%s'", source.Mode())
	}

	if source.Type() != domain.SourceType{{.Type}} {
		t.Errorf("expected type '{{.Type}}', got '%s'", source.Type())
	}

	// Cleanup
	if err := source.Close(); err != nil {
		t.Errorf("Close() failed: %v", err)
	}
}

