// getTestConfig returns a test configuration for {{.Name}}.
func getTestConfig() ports.SourceConfig {
	return ports.SourceConfig{
		Enabled:   true,
		Timeout:   {{.DefaultTimeout}} * time.Second,
		Retries:   2,
		RateLimit: 0,
		Priority:  {{.Priority}},
		Custom: map[string]interface{}{
{{- if eq .Type "CLI"}}
			"exec_path": "{{.BinaryName}}",
{{- end}}
{{- range .CustomConfigFields}}
			"{{.Key}}": {{.TestValue}},
{{- end}}
		},
	}
}
