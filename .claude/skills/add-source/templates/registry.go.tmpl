package {{.Name}}

import (
	"aethonx/internal/core/domain"
	"aethonx/internal/core/ports"
	"aethonx/internal/platform/logx"
	"aethonx/internal/platform/registry"
)

// Auto-registration on package import using registry helpers
func init() {
	if err := registry.Global().Register(
		"{{.Name}}",
		factory,
		ports.SourceMetadata{
			Name:         "{{.Name}}",
			Description:  "{{.Description}}",
			Version:      "1.0.0",
			Author:       "AethonX",
			Mode:         domain.SourceMode{{.Mode}},
			Type:         domain.SourceType{{.Type}},
			RequiresAuth: {{.RequiresAuth}},
			RateLimit:    {{.RateLimit}}, // {{.RateLimitComment}}

			// Dependency declaration for stage-based execution
			InputArtifacts: []domain.ArtifactType{
{{- range .InputArtifacts}}
				domain.ArtifactType{{.}},
{{- end}}
			},
			OutputArtifacts: []domain.ArtifactType{
{{- range .OutputArtifacts}}
				domain.ArtifactType{{.}},
{{- end}}
			},
			Priority:  {{.Priority}}, // {{.PriorityComment}}
			StageHint: {{.StageHint}}, // {{.StageComment}}
		},
	); err != nil {
		// Log error but don't panic - allow application to start
		logx.New().Warn("failed to register {{.Name}} source", "error", err.Error())
	}
}

// factory creates a new {{.StructName}} from SourceConfig using registry helpers
func factory(cfg ports.SourceConfig, logger logx.Logger) (ports.Source, error) {
	// Extract custom config using registry helpers (type-safe, no manual nil checks)
{{- if eq .Type "CLI"}}
	execPath := registry.GetStringConfig(cfg.Custom, "exec_path", "{{.BinaryName}}")
{{- end}}
{{- range .CustomConfigFields}}
	{{.VarName}} := registry.{{.HelperFunc}}(cfg.Custom, "{{.Key}}", {{.DefaultValue}})
{{- end}}

	// Use configured timeout or default
	timeout := cfg.Timeout
	if timeout == 0 {
		timeout = defaultTimeout
	}

{{- if eq .Type "CLI"}}
	return NewWithConfig(logger, execPath, timeout{{range .CustomConfigFields}}, {{.VarName}}{{end}}), nil
{{- else}}
	return NewWithConfig(logger{{range .CustomConfigFields}}, {{.VarName}}{{end}}), nil
{{- end}}
}
