// RunWithInput executes {{.BinaryName}} with artifacts from previous stages.
func (s *{{.StructName}}) RunWithInput(ctx context.Context, target domain.Target, input *domain.ScanResult) (*domain.ScanResult, error) {
	// Filter input artifacts for processing
	items := s.extractInputItems(input)

	if len(items) == 0 {
		s.GetLogger().Info("no input items to process", "target", target.Root)
		return domain.NewScanResult(target), nil
	}

	s.GetLogger().Info("starting {{.Name}} scan with input",
		"target", target.Root,
		"input_items", len(items),
	)

	// Build command arguments
	args := s.buildCommandArgs(target)

	// Create handler
	handler := &{{.Name}}Handler{
		parser:    s.parser,
		target:    target,
		logger:    s.GetLogger(),
		responses: make([]{{.ResponseType}}, 0, 100),
	}

	// Execute with stdin
	result, stderrOutput, err := s.ExecuteCLIWithStdin(ctx, target, args, items, handler)

	// Handle errors (same as Run)
	if result == nil {
		return nil, fmt.Errorf("{{.Name}} failed to start: %w", err)
	}

	if len(stderrOutput) > 0 {
		result.AddWarning("{{.Name}}", fmt.Sprintf("stderr: %s", stderrOutput))
	}

	if err != nil && len(handler.responses) == 0 {
		return nil, fmt.Errorf("{{.Name}} failed: %w", err)
	}

	// Parse artifacts
	artifacts := s.parser.ParseMultipleResponses(handler.responses, target)
	for _, artifact := range artifacts {
		result.AddArtifact(artifact)
	}

	s.GetLogger().Info("{{.Name}} scan with input completed",
		"artifacts", len(result.Artifacts),
	)

	return result, nil
}

// extractInputItems extracts relevant items from input artifacts.
func (s *{{.StructName}}) extractInputItems(input *domain.ScanResult) []string {
	items := make([]string, 0)
	seen := make(map[string]bool)

	for _, artifact := range input.Artifacts {
		// Filter by input artifact types
{{- range .InputArtifacts}}
		if artifact.Type == domain.ArtifactType{{.}} {
			if !seen[artifact.Value] {
				items = append(items, artifact.Value)
				seen[artifact.Value] = true
			}
		}
{{- end}}
	}

	return items
}
{{- end}}

// {{.Name}}Handler implements common.OutputHandler for {{.BinaryName}} output processing.
type {{.Name}}Handler struct {
	parser    *Parser
	target    domain.Target
	logger    logx.Logger
	responses []{{.ResponseType}}
	mu        sync.Mutex
}

// ProcessLine handles each line of {{.BinaryName}} stdout.
func (h *{{.Name}}Handler) ProcessLine(line []byte) error {
	h.mu.Lock()
	defer h.mu.Unlock()

	// TODO: Implement parsing logic for {{.BinaryName}} output
	// This is a placeholder - adjust based on actual output format

	var resp {{.ResponseType}}
	if err := json.Unmarshal(line, &resp); err != nil {
		h.logger.Warn("failed to parse {{.Name}} output", "line", string(line), "error", err.Error())
		return nil // Non-fatal, continue processing
	}

	h.responses = append(h.responses, resp)

	h.logger.Debug("parsed {{.Name}} response",
		"response", fmt.Sprintf("%+v", resp),
	)

	return nil
}

// Finalize is called after all lines are processed.
func (h *{{.Name}}Handler) Finalize() error {
	h.mu.Lock()
	defer h.mu.Unlock()

	h.logger.Info("parsing responses to artifacts", "count", len(h.responses))
	return nil
}

