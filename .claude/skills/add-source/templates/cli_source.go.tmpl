// Run executes {{.BinaryName}} against the target.
func (s *{{.StructName}}) Run(ctx context.Context, target domain.Target) (*domain.ScanResult, error) {
	startTime := time.Now()

	s.GetLogger().Info("starting {{.Name}} scan",
		"target", target.Root,
{{- range .LogFields}}
		"{{.Key}}", s.{{.Field}},
{{- end}}
	)

	// Build command arguments
	args := s.buildCommandArgs(target)

	// Create handler for processing output
	handler := &{{.Name}}Handler{
		parser:    s.parser,
		target:    target,
		logger:    s.GetLogger(),
		responses: make([]{{.ResponseType}}, 0, 100),
	}

	// Execute CLI with handler (BaseCLISource handles all subprocess logic)
{{- if .UsesStdin}}
	result, stderrOutput, err := s.ExecuteCLIWithStdin(ctx, target, args, inputItems, handler)
{{- else}}
	result, stderrOutput, err := s.ExecuteCLI(ctx, target, args, handler)
{{- end}}

	// Handle fatal errors (e.g., failed to start process)
	if result == nil {
		return nil, fmt.Errorf("{{.Name}} failed to start: %w", err)
	}

	// Handle stderr warnings
	if len(stderrOutput) > 0 {
		s.GetLogger().Debug("{{.Name}} stderr", "output", stderrOutput)
		result.AddWarning("{{.Name}}", fmt.Sprintf("stderr output: %s", stderrOutput))
	}

	// Handle errors (partial results tolerated)
	if err != nil {
		responseCount := len(handler.responses)
		if responseCount > 0 {
			s.GetLogger().Warn("{{.Name}} exited with error but produced results",
				"error", err.Error(),
				"responses", responseCount,
			)
			result.AddWarning("{{.Name}}", fmt.Sprintf("process exited with error: %v", err))
		} else {
			return nil, fmt.Errorf("{{.Name}} failed: %w", err)
		}
	}

	// Parse responses into artifacts
	artifacts := s.parser.ParseMultipleResponses(handler.responses, target)
	for _, artifact := range artifacts {
		result.AddArtifact(artifact)
	}

	duration := time.Since(startTime)
	s.GetLogger().Info("{{.Name}} scan completed",
		"target", target.Root,
		"duration", duration.String(),
		"responses", len(handler.responses),
		"artifacts", len(result.Artifacts),
	)

	return result, nil
}

